"""
AFBoxplotExplanVar — Python translation of MATLAB AFBoxplotExplanVar appendix.

Sections:
  1. Print instructions about regression variable selection.
  2. Assemble NLCD THS matrix and initialise regression design matrix.
  3. Figure 20 — boxplot of NLCD land-cover fractions.
  4. Figure 21 — boxplot of monthly PRISM precipitation.
  5. Figure 22 — boxplot of monthly PRISM temperature.
"""

from __future__ import annotations

from typing import List

import numpy as np
import matplotlib.pyplot as plt


NLCD_CODES = [
    "11", "12", "21", "22", "23", "31", "32", "33",
    "41", "42", "43", "51", "61", "71",
    "81", "82", "83", "84", "85", "91", "92",
]


def boxplot_explanatory_vars(
    nlcd_ths: np.ndarray,
    prsm_prec_ths: np.ndarray,
    prsm_temp_ths: np.ndarray,
    n_r: int,
    n_ths: int,
    ny: int,
    wy1: int,
    mo_name: List[str],
    make_plots: bool = True,
) -> dict:
    """Assemble regression inputs and plot explanatory-variable diagnostics.

    Parameters
    ----------
    nlcd_ths:
        NLCD fractions for each THS catchment, shape ``(nTHS, 21)``.
        Columns follow ``NLCD_CODES`` order.
    prsm_prec_ths:
        PRISM precipitation, shape ``(Ny, nTHS, 12)``.
    prsm_temp_ths:
        PRISM temperature, shape ``(Ny, nTHS, 12)``.
    n_r:
        Number of explanatory variables (regression terms).
    n_ths:
        Number of THS catchments.
    ny:
        Total number of water years.
    wy1:
        First water year of the analysis period.
    mo_name:
        12-element list of month name abbreviations (water-year order).
    make_plots:
        If ``False``, skip figure creation.

    Returns
    -------
    dict with keys:
      ``nlcd_ths_mat``   — assembled ``(nTHS, 21)`` NLCD array,
      ``reg_design_mat`` — zero-initialised ``(nTHS, Nr)`` design matrix (float32).
    """
    print(
        f"\nBased on the number of explanatory variables specified, a series\n"
        f"of {n_r} screens will be presented to select explanatory variables\n"
        "Each screen will correspond to one explanatory variable.\n"
        "Each checked box in the NLCD list will be added to the contents of\n"
        "the corresponding field to the explanatory variable as a partial\n"
        "sum. A checked box in the PRISM climatic variables will be added as\n"
        "an individual explanatory variable. The rank of the\n"
        "design matrix will be determined and a boxplot showing the\n"
        "the explanatory variables will be generated as an aid to\n"
        "ensuring that the specified regression equation is estimatible."
    )

    # ------------------------------------------------------------------
    # 1. Assemble NLCD matrix and initialise design matrix
    # ------------------------------------------------------------------
    nlcd_ths_mat = np.asarray(nlcd_ths, dtype=float)        # (nTHS, 21)
    reg_design_mat = np.zeros((n_ths, n_r), dtype=np.float32)

    if not make_plots:
        return {"nlcd_ths_mat": nlcd_ths_mat, "reg_design_mat": reg_design_mat}

    last_wy = wy1 + ny - 1

    # ------------------------------------------------------------------
    # 2. Figure 20 — NLCD boxplot
    # ------------------------------------------------------------------
    fig20, ax20 = plt.subplots(figsize=(14, 5))
    fig20.canvas.manager.set_window_title("NLCD 1992 Land Use/Cover Data")
    ax20.boxplot(
        [nlcd_ths_mat[:, i] for i in range(21)],
        labels=NLCD_CODES,
        whis=1e4,           # whisker=10000 → show all data within whiskers
    )
    ax20.set_xlabel("NATIONAL LAND COVER DATASET (1992) CLASSIFICATION CODE")
    ax20.set_ylabel("PERCENTAGE OF CATCHMENT AREA")
    fig20.tight_layout()

    # ------------------------------------------------------------------
    # 3. Figure 21 — PRISM precipitation boxplot (last water year)
    # ------------------------------------------------------------------
    prec_last = prsm_prec_ths[ny - 1, :, :12]              # (nTHS, 12)
    fig21, ax21 = plt.subplots(figsize=(10, 5))
    fig21.canvas.manager.set_window_title("PRISM Total Monthly Precipitation")
    ax21.boxplot(
        [prec_last[:, m] for m in range(12)],
        labels=mo_name,
    )
    ax21.set_xlabel(f"Month of Water Year {last_wy}")
    ax21.set_ylabel("Precipitation, in inches")
    fig21.tight_layout()

    # ------------------------------------------------------------------
    # 4. Figure 22 — PRISM temperature boxplot (last water year)
    # ------------------------------------------------------------------
    temp_last = prsm_temp_ths[ny - 1, :, :12]              # (nTHS, 12)
    fig22, ax22 = plt.subplots(figsize=(10, 5))
    fig22.canvas.manager.set_window_title(
        "PRISM Average of Minimum and Maximum Monthly Temperature"
    )
    ax22.boxplot(
        [temp_last[:, m] for m in range(12)],
        labels=mo_name,
    )
    ax22.set_xlabel(f"Month of Water Year {last_wy}")
    ax22.set_ylabel("Temperature, in degrees Celcius")
    fig22.tight_layout()

    plt.show()

    return {"nlcd_ths_mat": nlcd_ths_mat, "reg_design_mat": reg_design_mat}
